<% if with_title %>
  <%= content_for :title, t('page_titles.your_applications') %>

  <h1 class="govuk-heading-xl">
    <%= t('mid_cycle_content_component.title') %>
  </h1>
<% end %>

<% if total_submitted_application_limit_reached? %>
  <p class="govuk-body">
    <%= t('mid_cycle_content_component.you_cannot_submit_more', max_number_of_applications:) %>
  </p>

  <p class="govuk-body">
    <%= govuk_link_to t('mid_cycle_content_component.read_how_the_application_process_works'), candidate_interface_guidance_path %>
  </p>

  <p class="govuk-body">
    <%= t('mid_cycle_content_component.you_will_be_able_to_apply_again', apply_reopens_date:, next_year:) %>
  </p>

  <p class="govuk-body">
    <%= t('mid_cycle_content_component.training_providers_offer_places_throughout_the_year') %>
  </p>
<% elsif can_add_more_choices? %>
  <%= holiday_response_time_warning_text %>
  <p class="govuk-body">
     <%= t(
           'mid_cycle_content_component.applications_left_message.can_add_more',
           count: number_of_slots_left,
           academic_year: academic_year_range_name,
         ) %>
  </p>
  <p class="govuk-body">
    <%= t('mid_cycle_content_component.applications_left_message.in_progress', count: in_progress_limit) %>
  </p>
  <%= how_to_free_up_a_slot_list %>
  <p class="govuk-body">
    <%= t('mid_cycle_content_component.once_you_have_reached_the_limit', max_number_of_applications:) %>
  </p>
  <p class="govuk-body">
    <%= govuk_link_to t('mid_cycle_content_component.read_how_the_application_process_works'), candidate_interface_guidance_path %>
  </p>
  <p class="govuk-body">
    <%= t('mid_cycle_content_component.training_providers_offer_places_throughout_the_year') %>
  </p>

  <%= render CandidateInterface::CarryOverTaskListComponent.new(application_form:) %>

  <%= govuk_button_link_to t('mid_cycle_content_component.add_application'), candidate_interface_course_choices_do_you_know_the_course_path %>
<% else %>
  <%= holiday_response_time_warning_text %>
  <%= no_more_slots_message %>
  <p class="govuk-body">
    <%= t('mid_cycle_content_component.you_can_add_more_applications_if') %>
  </p>

  <%= how_to_free_up_a_slot_list %>
  <p class="govuk-body">
    <%= t('mid_cycle_content_component.once_you_have_reached_the_limit', max_number_of_applications:) %>
  </p>

  <p class="govuk-body">
    <%= govuk_link_to t('mid_cycle_content_component.read_how_the_application_process_works'), candidate_interface_guidance_path %>
  </p>

  <p class="govuk-body">
    <%= t('mid_cycle_content_component.training_providers_offer_places_throughout_the_year') %>
  </p>
<% end %>

<div>
  <%= render CandidateInterface::ApplicationChoiceListComponent.new(
    application_form:,
    application_choices:,
    current_tab_name: params[:current_tab_name],
  ) %>
</div>
