<table class="govuk-table">
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Email address</th>
      <% accounts.each do |account| %>
        <th scope="col" class="govuk-table__header">
          <%= govuk_link_to account.email_address, support_interface_candidate_path(account.candidate_id) %>
        </th>
      <% end %>
    </tr>
  </thead>
  <tbody class="govuk-table__body">
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">One Login email address</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell"><%= account.one_login_email_address %></td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Created at</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell"><%= account.created_at %></td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Name</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell"><%= account.name %></td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Date of birth</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell"><%= account.date_of_birth %></td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Address</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell">
          <% account.address.each do |address_line| %>
            <%= address_line %><br role="presentation">
          <% end %>
        </td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Applications submitted</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell"><%= account.application_status %></td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Application progress</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell">
          <% account.application_progress.each do |status, number| %>
            <p class="govuk-body">
              <%= number %> x <%= render SupportInterface::ApplicationStatusTagComponent.new(status: status) %>
            </p>
          <% end %>
        </td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Safeguarding information</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell">
          <% if account.safeguarding_concerns.present? %>
            <p class="govuk-body">
              <%= govuk_link_to account.safeguarding_concerns, "#{support_interface_application_form_path(account.current_application)}#safeguarding-section" %>
            </p>
          <% end %>
          <% if account.reference_safeguarding_concerns.present? %>
            <p class="govuk-body">
              <%= govuk_link_to account.reference_safeguarding_concerns, "#{support_interface_application_form_path(account.current_application)}#references" %>
            </p>
          <% end %>
          <% if account.safeguarding_concerns.blank? && account.reference_safeguarding_concerns.blank? %>
            <p class="govuk-body">
              None
            </p>
          <% end %>
        </td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Account status</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell"><%= account.account_status %></td>
      <% end %>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header govuk-!-font-weight-regular">Actions</th>
      <% accounts.each do |account| %>
        <td class="govuk-table__cell">
          <%= form_with(
            url: support_interface_update_multiple_candidate_account_statuses_path,
            method: :patch,
            scope: 'support_interface_multiple_candidate_account_status_form',
          ) do |f| %>
            <%= f.hidden_field :status, value: account.account_status == 'Active' ? 'account_access_locked' : 'unblocked' %>
            <%= f.hidden_field 'candidate_ids', value: account.candidate_id, multiple: true %>
            <%= f.hidden_field :match_id, value: match.id %>
<<<<<<< HEAD
            <%= f.govuk_submit(account.account_status == 'Active' ? 'Lock account' : 'Unlock account', secondary: true, class: 'govuk-button govuk-!-margin-0') %>
=======
            <%= f.govuk_submit(account.account_status == 'Active' ? 'Lock account' : 'Unlock account', secondary: true) %>
>>>>>>> 1a18a2787c (Lock and unlock accounts)
          <% end %>
        </td>
      <% end %>
    </tr>
  </tbody>
</table>

<% if accounts.any? { |account| account.account_status != 'Active' } %>
  <%= form_with(
    url: support_interface_update_multiple_candidate_account_statuses_path,
    method: :patch,
    scope: 'support_interface_multiple_candidate_account_status_form',
  ) do |f| %>
    <%= f.hidden_field :status, value: 'unblocked' %>
    <% match.candidates.each do |candidate| %>
      <%= f.hidden_field 'candidate_ids', value: candidate.id, multiple: true %>
    <% end %>
    <%= f.hidden_field :match_id, value: match.id %>
    <%= f.govuk_submit('Unlock all', secondary: true, class: 'govuk-button govuk-!-margin-0') %>
  <% end %>
<% end %>
