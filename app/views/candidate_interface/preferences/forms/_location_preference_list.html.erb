<%= form_with model: @wizard.current_step,
              url: @wizard.current_step_path,
              scope: @wizard.current_step_name do |f| %>
  <span class="govuk-caption-l"><%= t('.caption') %></span>
  <h1 class="govuk-heading-xl govuk-!-margin-bottom-4"><%= t('.title') %></h1>
  <p class="govuk-body"><%= t('.body') %></p>

  <%= f.govuk_error_summary %>

  <% if @wizard.location_preferences.blank? %>
    <p class="govuk-body"><%= t('.no_location_preferences') %></p>

    <%= govuk_button_link_to(
      t('.add_location'),
      candidate_interface_new_preferences_path(step: 'add_location_preference'),
      secondary: true,
    ) %>
  <% else %>
    <h2 class="govuk-heading-m"><%= t('.select_locations') %></h2>

    <%= govuk_table(html_attributes: { class: 'app-table__row--no-bottom-border govuk-!-margin-bottom-0' }) do |table| %>
      <% table.with_head do |head| %>
        <% head.with_row do |row| %>
          <%= row.with_cell(text: t('.distance_from_location')) %>
          <%= row.with_cell(text: t('.location')) %>
        <% end %>
      <% end %>

      <% table.with_body do |body| %>
        <% @wizard.location_preferences.each do |location| %>
          <% body.with_row do |row| %>
            <%= row.with_cell(text: t('.within', within: location.dig(:within))) %>

            <%= row.with_cell(text: location.dig(:location_name)) %>
            <%= row.with_cell do %>
              <%= govuk_link_to(
                t('.change'),
                candidate_interface_new_preferences_path(step: 'add_location_preference', uuid: location.dig(:uuid)),
                visually_hidden_suffix: location.dig(:location_name),
              ) %>
            <% end %>
            <%= row.with_cell do %>
              <%= govuk_link_to(
                t('.remove'),
                candidate_interface_new_preferences_path(step: 'remove_location_preference', uuid: location.dig(:uuid)),
                visually_hidden_suffix: location.dig(:location_name),
              ) %>
            <% end %>
          <% end %>
        <% end %>

        <% body.with_row do |row| %>
          <%= row.with_cell(colspan: 4) do %>
            <%= govuk_button_link_to(
              t('.add_another_location'),
              candidate_interface_new_preferences_path(step: 'add_location_preference'),
              secondary: true,
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <div><%= f.govuk_submit %></div>
<% end %>
