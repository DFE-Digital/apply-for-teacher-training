<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <% content_for :title, title_with_error_prefix(t('page_titles.degree_subject_area'), @form.errors.any?) %>
    <% content_for :before_content, govuk_back_link_to(@form.back_link) %>

    <%= form_with model: @form, url: candidate_interface_degree_subject_area_path, scope: :candidate_interface_degree_form do |f| %>
      <%= f.govuk_error_summary %>

      <%= f.govuk_check_boxes_fieldset :subject_areas, legend: { text: t('page_titles.degree_subject_area'), size: 'l' } do %>
        <% @form.subject_groups.each_with_index do |subject_area, i| %>
        <%= f.govuk_check_box :subject_areas,
                              subject_area.id,
                              multiple: true,
                              label: { text: subject_area.name },
                              link_errors: i.zero? %>
        <% end %>

        <%= f.govuk_check_box_divider %>

        <%= f.govuk_check_box :subject_areas,
                              CandidateInterface::Degrees::BaseForm::NOT_APPLICABLE,
                              exclusive: true,
                              label: { text: 'None of these' },
                              link_errors: false %>
      <% end %>

      <%= f.govuk_submit t('save_and_continue') %>
    <% end %>
  </div>
</div>
