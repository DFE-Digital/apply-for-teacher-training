<%= f.govuk_error_summary %>
<%= f.hidden_field(:application_choice_id, value: params[:application_choice_id]) %>

<%= f.govuk_radio_buttons_fieldset(
  :visa_explanation,
  legend: { text: t('visa_expiry_form.visa_explanation_label'), tag: 'h1', size: 'l' },
) do %>
  <% unless @wizard.requires_visa_sponsorship? %>
    <%= f.govuk_radio_button(
      :visa_explanation,
      :expires_after_course,
      link_errors: true,
      label: { text: t('visa_expiry_form.options.expires_after_course') },
    ) %>
  <% end %>
  <%= f.govuk_radio_button(
    :visa_explanation,
    :renew,
    label: { text: t('visa_expiry_form.options.renew') },
  ) %>
  <%= f.govuk_radio_button(
    :visa_explanation,
    :leads_to_permanent_visa,
    label: { text: t('visa_expiry_form.options.leads_to_permanent_visa') },
  ) %>
  <%= f.govuk_radio_button(
    :visa_explanation,
    :switch_to_different_visa,
    label: { text: t('visa_expiry_form.options.switch_to_different_visa') },
  ) %>

  <%= f.govuk_radio_button(
    :visa_explanation,
    :other,
    label: { text: t('visa_expiry_form.options.other') },
  ) do %>
    <%= f.govuk_text_area(
      :visa_explanation_details,
      label: { text: t('visa_expiry_form.options.details'), size: 's' },
      max_length: 200,
      count_type: :words,
      rows: 5,
    ) %>
  <% end %>

  <%= f.govuk_radio_button(
    :visa_explanation,
    :not_sure,
    label: { text: t('visa_expiry_form.options.not_sure') },
  ) do %>
    <p class='govuk-hint'>
      <%= t('visa_expiry_form.unluckily_successful') %>
    </p>
  <% end %>
<% end %>

<%= f.govuk_submit t('continue') %>
