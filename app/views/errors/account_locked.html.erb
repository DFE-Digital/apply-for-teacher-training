<%= content_for :title, t('page_titles.account_locked') %>
<%= content_for :error_type, 'account_locked' %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l"><%= t('page_titles.account_locked') %></h1>
    <p class="govuk-body">You already have an Apply for teacher training account, so we’ve locked this account.</p>
    <p class="govuk-body">
      We’ve sent an email to the address linked to your original account. Follow the link in the email to sign in and continue your application, or <%= govuk_link_to 'sign in here', candidate_interface_create_account_or_sign_in_path %>.
    </p>
    <p class="govuk-body">
      If you cannot access your original account or the email address linked to it, contact <%= govuk_mail_to 'becomingateacher@digital.education.gov.uk', 'becomingateacher@digital.education.gov.uk' %>.
    </p>
  </div>
</div>
