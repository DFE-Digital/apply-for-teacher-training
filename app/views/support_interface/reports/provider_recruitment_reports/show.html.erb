<%= render 'support_interface/providers/providers_navigation', title: 'Providers' %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      <%= t(
        'page_titles.provider_recruitment_performance_report',
        cycle_year: @recruitment_cycle_year,
      ) %>
    </h1>

    <%= form_with url: request.path, method: :get do |f| %>
      <div data-controller='submit-on-click'>
        <%= f.govuk_select(
          :provider_id,
          options_for_select(Provider.all.map { |p| [p.name, p.id] }, @provider.id),
          label: { size: 's', text: 'Select provider' },
          data: { action: 'change->submit-on-click#call', submit_on_click_target: 'input' },
        ) %>

        <%= hidden_field_tag :recruitment_cycle_year, @recruitment_cycle_year %>
        <%= hidden_field_tag :region, @region %>
      </div>
    <% end %>

    <% if @provider_recruitment_component.reports_ready %>
      <p class="govuk-body">
        <%= govuk_link_to(
          'Export data (ZIP)',
          support_interface_reports_provider_recruitment_report_path(
            provider_id: @provider.id,
            region: @region,
            recruitment_cycle_year: @recruitment_cycle_year,
            format: :zip,
          ),
        ) %>
      </p>
      <% unless RecruitmentPerformanceReportTimetable.report_season? %>
        <p class="govuk-body govuk-!-font-weight-bold">
          <%= t(
            'reports.provider_recruitment_reports.not_available_yet_to_providers',
            first_publication_date: RecruitmentPerformanceReportTimetable.first_publication_date.to_fs(:govuk_date),
          ) %>
        </p>
      <% end %>
    <% else %>
      <% if @recruitment_cycle_year == RecruitmentCycleTimetable.previous_year || RecruitmentPerformanceReportTimetable.report_season? %>
        <%= govuk_link_to(
          'Set your comparison area',
          @comparison_link,
          class: 'govuk-button govuk-button--secondary',
        ) %>
      <% end %>

      <p class="govuk-body">
        <%= t('reports.provider_recruitment_reports.not_ready_to_view') %>
      </p>
    <% end %>
  </div>

  <%= render @provider_recruitment_component %>
</div>
