<%= render 'support_interface/providers/provider_navigation', title: t('page_titles.recruitment_performance_report') %>
<%= govuk_back_link(href: @backlink) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with(
      model: @form,
      url: support_interface_regional_report_filters_path,
    ) do |f| %>
      <%= f.hidden_field :return_to, value: params[:return_to] %>
      <%= f.hidden_field :recruitment_cycle_year, value: @recruitment_cycle_year %>
      <%= f.govuk_error_summary %>

      <%= f.govuk_collection_radio_buttons(
        :region,
        @form.options,
        :value,
        :label,
        bold_labels: false,
        legend: { text: 'Set a comparison area', size: 'm' },
      ) %>

      <%= f.govuk_submit 'Update comparison area' %>
    <% end %>
  </div>
</div>
