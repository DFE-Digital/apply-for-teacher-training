<% if @gcse_form.selected_grade_schema_percentage? && !@gcse_form.grade_is_other? %>
  <%= f.govuk_text_field :grade, width: 3, label: { text: t('gcse_edit_new_international_flow_grade.page_title'), size: 'm' }, suffix_text: '%', inputmode: 'numeric' %>
<% elsif @gcse_form.structured_grades.any? && !@gcse_form.selected_grade_schema_percentage? %>
  <%= f.govuk_radio_buttons_fieldset :grade, legend: { text: t('gcse_edit_new_international_flow_grade.page_title'), size: 'm' } do %>
    <% @gcse_form.structured_grades.each_with_index do |grade, i| %>
      <%= f.govuk_radio_button :grade, grade, label: { text: grade }, link_errors: i.zero? %>
    <% end %>

    <%= f.govuk_radio_divider %>

    <%= f.govuk_radio_button :grade, 'other', label: { text: 'Other' }  do %>
      <%= f.govuk_text_field :other_grade, label: { text: t('application_form.gcse.non_uk_other_grade.label'), size: 's' }, hint: { text: t('application_form.gcse.non_uk_other_grade.hint_text') } %>
    <% end %>
  <% end %>
<% elsif @gcse_form.other_international_grade? %>
  <%= f.hidden_field :grade, value: 'other' %>
  <%= f.govuk_text_field :other_grade, width: 3, label: { text: t('application_form.gcse.non_uk_other_grade.non_structured_label'), size: 'm' }, hint: { text: t('application_form.gcse.non_uk_other_grade.hint_text') } %>
<% else %>
    <%= f.govuk_text_field :grade, width: 3, label: { text: t('application_form.gcse.non_uk_other_grade.non_structured_label'), size: 'm' }, hint: { text: t('application_form.gcse.non_uk_other_grade.hint_text') } %>
<% end %>
