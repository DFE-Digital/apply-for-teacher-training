<% content_for :browser_title, title_with_error_prefix(t('.title'), @form.errors.any?) %>
<% content_for :before_content, govuk_back_link_to(support_interface_application_form_path(@application_form)) %>

<h1 class="govuk-heading-l">
  <%= t('.title') %>
</h1>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with(
      model: @form,
      url: support_interface_application_form_update_declaration_previous_teacher_trainings_path(@application_form, @previous_teacher_training),
      method: :patch,
    ) do |f| %>
      <%= f.govuk_error_summary %>

      <%= f.govuk_collection_radio_buttons(
        :started,
        @form.options,
        :value,
        :name,
        bold_labels: false,
        legend: { text: t('.form.started'), size: 'm' },
      ) %>

      <%= f.govuk_text_field :audit_comment, label: { text: 'Zendesk ticket', size: 'm' } %>

      <%= f.govuk_submit t('save_and_continue') %>
    <% end %>
  </div>
</div>
