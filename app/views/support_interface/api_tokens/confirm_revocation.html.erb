<%= render 'support_interface/providers/providers_navigation', title: 'API tokens' %>

<% content_for :before_content do %>
  <%= govuk_back_link(
    text: 'Back',
    href: support_interface_api_token_path(@api_token),
  ) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @revoke_token_form, url: revoke_support_interface_api_token_path(@api_token), method: :put do |f| %>

      <%= f.govuk_error_summary %>

      <h1 class="govuk-heading-l"><%= t('.title', token: @api_token.name) %></h1>
      <%= govuk_warning_text(text: t('.warning')) %>

      <%= render APITokenSummaryComponent.new(
        token: @api_token,
        can_manage_tokens: @can_manage_tokens,
        view: 'confirm_revoke',
        interface: 'support',
      ) %>

      <%= f.govuk_text_field :audit_comment, label: { text: t('.audit_comment'), size: 'm' }, hint: { text: t('.hint') } %>

      <%= f.govuk_submit t('.revoke_token'), warning: true %>
    <% end %>
  </div>
</div>
