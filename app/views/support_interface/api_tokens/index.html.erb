<%= render 'support_interface/providers/providers_navigation', title: t('.title') %>

<%= govuk_button_link_to(
  t('.download_csv'),
  support_interface_api_tokens_path(params: @filter.applied_filters, format: :csv),
  secondary: true,
) %>

<nav class="app-tab-navigation" aria-label="sub menu" data-qa="sub-navigation">
  <ul class="app-tab-navigation__list govuk-!-display-none-print">
    <li class="app-tab-navigation__item">
      <%= govuk_link_to(
        t('.active_tokens'),
        support_interface_api_tokens_path,
        class: 'app-tab-navigation__link',
        aria: { current: params[:filter_tab].blank? ? 'page' : '' },
      ) %>
    </li>
    <li class="app-tab-navigation__item">
      <%= govuk_link_to(
        t('.revoked_tokens'),
        support_interface_api_tokens_path(
          filter_tab: 'revoked',
        ),
        class: 'app-tab-navigation__link',
        aria: { current: params[:filter_tab] == 'revoked' ? 'page' : '' },
      ) %>
    </li>
  </ul>
</nav>

<%= render PaginatedFilterComponent.new(filter: @filter, collection: @api_tokens) do %>
  <%= govuk_table do |table| %>
    <%= table.with_head do |head| %>
      <%= head.with_row do |row| %>
        <%= row.with_cell(text: t('.provider')) %>
        <%= row.with_cell(text: t('.name')) %>
        <%= row.with_cell(text: t('.created')) %>
        <%= row.with_cell(text: t('.last_used')) %>
      <% end %>
    <% end %>

    <% @api_tokens.each do |token| %>
      <%= table.with_body do |body| %>
        <%= body.with_row do |row| %>
          <%= row.with_cell(text: token.provider.name_and_code) %>
          <%= row.with_cell(text: govuk_link_to(token.name, support_interface_api_token_path(token.id))) %>
          <%= row.with_cell(text: token.created_at) %>
          <%= row.with_cell(text: token.last_used_at&.to_fs(:govuk_date_and_time) || t('.not_used')) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= govuk_pagination(pagy: @pagy) %>
<% end %>
