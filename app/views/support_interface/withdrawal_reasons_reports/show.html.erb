<%= render 'support_interface/providers/provider_navigation', title: 'Reports' %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      <span class="govuk-caption-l"> <%= @provider.name %></span>
      <%= t('page_titles.withdrawal_reasons_report') %>
    </h1>

    <% if @withdrawal_reason_report.show_report? %>
      <%= t(
        'reports.withdrawal_reasons_reports.report_description_html',
        generated_at: @withdrawal_reason_report.generated_at.to_fs(:govuk_date_and_time),
      ) %>
    <% else %>
      <%= t('reports.withdrawal_reasons_reports.report_not_visible_html') %>
    <% end %>
  </div>

  <%= render(
    WithdrawalReasonsReportsComponent.new(
      withdrawal_reason_report: @withdrawal_reason_report,
    ),
  ) %>
</div>
