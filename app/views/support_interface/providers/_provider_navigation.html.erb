<% content_for :title, "#{title} - #{@provider.name_and_code}" %>

<% content_for :before_content do %>
  <%= breadcrumbs({
    Providers: support_interface_providers_path(onboarding_stages: %w[synced dsa_signed]),
    @provider.name => support_interface_provider_path(@provider),
  }.merge(title == 'Details' ? {} : { title => nil })) %>
<% end %>

<%= render 'support_interface/providers/lacks_admin_users_warning' %>

<% report_paths = %w[provider-recruitment-report status-of-active-applications withdrawal-reasons-report] %>
<%= render TabNavigationComponent.new(items: support_user_provider_nav_items(current_support_user, report_current: report_paths.any? { |path| request.path.include?(path) })) %>

<h2 class="govuk-visually-hidden"><%= title %></h2>
