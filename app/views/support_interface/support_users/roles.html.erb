<% content_for :browser_title, 'Roles and permissions' %>
<% content_for :before_content, govuk_back_link_to(@back_link) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Roles and permissions</h1>

    <p class='govuk-body'>
      This page explains the different roles and what each role can access and change.
    </p>

    <h2 class="app-contents-list__title">Contents</h2>
    <ol class="app-contents-list__list">
      <li class="app-contents-list__list-item app-contents-list__list-item--parent">
        <%= govuk_link_to 'Types of roles', '#types_of_roles', class: 'app-contents-list__link' %>

        <ol class="app-contents-list__nested-list">
          <% @roles.each do |role| %>
            <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
              <%= govuk_link_to t("support_interface.support_user.roles.#{role}"), "##{role}", class: 'app-contents-list__link' %>
            </li>
          <% end %>
        </ol>
      </li>

      <li class="app-contents-list__list-item app-contents-list__list-item--parent">
        <%= govuk_link_to 'What each role can access and change', '#access_and_change', class: 'app-contents-list__link' %>

        <ol class="app-contents-list__nested-list">
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Candidate data', "#candidate_data", class: 'app-contents-list__link' %>
          </li>
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Organisational provider data', "#organisational_provider_data", class: 'app-contents-list__link' %>
          </li>
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Provider user data', "#provider_user_data", class: 'app-contents-list__link' %>
          </li>
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Reports', "#reports", class: 'app-contents-list__link' %>
          </li>
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Feature flags', "#feature_flags", class: 'app-contents-list__link' %>
          </li>
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Service banners', "#service_banners", class: 'app-contents-list__link' %>
          </li>
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Documentation', "#documentation", class: 'app-contents-list__link' %>
          </li>
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Developer tools', "#developer_tools", class: 'app-contents-list__link' %>
          </li>
          <li class="app-contents-list__list-item app-contents-list__list-item--dashed">
            <%= govuk_link_to 'Support users', "#support_users", class: 'app-contents-list__link' %>
          </li>
        </ol>
      </li>
    </ol>

    <h2 class='govuk-heading-m govuk-!-margin-top-6' id='types_of_roles'>Types of roles</h2>

    <p class='govuk-body'>
      As a guide, job titles often align with these roles. But you must check the person needs that level of access for their work,
      rather than assigning a role based on job title alone.
    </p>

    <h3 class='govuk-heading-s' id='user_support'>User support</h3>
    <p class="govuk-body">
      This will often be assigned to support team members to resolve live user issues, handle support requests,
      manage operational incidents and perform service support activities.
    </p>

    <h3 class='govuk-heading-s' id='technical_management'>Technical management</h3>
    <p class="govuk-body">
      This will often be assigned to developers and technical leads to diagnose technical issues,
      perform root cause analysis, support incident resolution and maintain service operability.
    </p>

    <h3 class='govuk-heading-s' id='service_administration'>Service administration</h3>
    <p class="govuk-body">
      This will often be assigned to product managers, delivery managers and policy to investigate general non-user-specific issues,
      validate reported problems, understand service performance, and support prioritisation and decision-making.
    </p>

    <h3 class='govuk-heading-s' id='research_and_design'>Research and design</h3>
    <p class="govuk-body">
      This will often be assigned to user researchers, analysts and designers to understand user journeys and service
      interactions where production data is required and no suitable alternative exists.
    </p>

    <h2 class='govuk-heading-m govuk-!-margin-top-6' id='access_and_change'>What each role can access and change</h2>

    <h3 class='govuk-heading-s' id='candidate_data'>Candidate data</h3>

    <p class='govuk-body'>Includes email logs, application data and history.</p>

    <%= govuk_table do |table| %>
      <%= table.with_head do |head| %>
        <%= head.with_row do |row| %>
          <%= row.with_cell %>
          <% @roles.each do |role| %>
            <%= row.with_cell(text: t("support_interface.support_user.roles.#{role}")) %>
          <% end %>
        <% end %>

        <%= table.with_body do |body| %>
          <%= body.with_row do |row| %>
            <%= row.with_cell(header: true, text: 'View', width: 'one-quarter') %>
            <%= row.with_cell(text: 'Access') %>
            <%= row.with_cell(text: 'Access') %>
            <%= row.with_cell(text: 'No access') %>
            <%= row.with_cell(text: 'Access') %>
          <% end %>

          <%= body.with_row do |row| %>
            <%= row.with_cell(header: true, text: 'Edit', width: 'one-quarter') %>
            <%= row.with_cell(text: 'Access') %>
            <%= row.with_cell(text: 'Access') %>
            <%= row.with_cell(text: 'No access') %>
            <%= row.with_cell(text: 'No access') %>
          <% end %>

          <%= body.with_row do |row| %>
            <%= row.with_cell(header: true, text: 'Delete', width: 'one-quarter') %>
            <%= row.with_cell(text: 'Access') %>
            <%= row.with_cell(text: 'Access') %>
            <%= row.with_cell(text: 'No access') %>
            <%= row.with_cell(text: 'No access') %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

