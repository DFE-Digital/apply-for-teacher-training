<% content_for :browser_title, t('.title', token: @api_token.name) %>
<% content_for :before_content do %>
  <%= govuk_back_link(
    text: 'Back',
    href: provider_interface_organisation_settings_organisation_api_tokens_path(@provider),
  ) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-l"><%= @api_token.name %></h1>

    <%= render ProviderInterface::APITokenSummaryComponent.new(
      token: @api_token,
      can_manage_tokens: @can_manage_tokens,
      view: @api_token.discarded? ? 'revoked' : 'show',
    ) %>
  </div>
</div>
