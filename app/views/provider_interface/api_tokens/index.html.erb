<% content_for :browser_title, t('.title', provider_name: @provider.name) %>
<% content_for :before_content do %>
  <%= govuk_back_link(
    text: 'Back',
    href: provider_interface_organisation_settings_path(@provider),
  ) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-l">
      <span class="govuk-caption-l"><%= @provider.name %></span>
      <%= t('.api_tokens') %>
    </h1>
    <p class="govuk-body">
      <%= t(
            '.what_tokens_are_for_html',
            link: govuk_link_to(
              t(
                '.apply_api',
                environment: HostingEnvironment.environment_name,
              ),
              api_docs_home_path,
              target: :blank,
            ),
          ) %>
    </p>

    <p class="govuk-body"><%= t('.warning') %></p>

    <% if @can_manage_tokens %>
      <%= govuk_button_link_to t('.add_token'), new_provider_interface_organisation_settings_organisation_api_token_path(@provider) %>
    <% end %>
  </div>

  <div class="govuk-grid-column-full">
    <% if @total_tokens.zero? %>
      <p class="govuk-body"><%= t('.no_tokens') %></p>
    <% else %>
      <nav class="app-tab-navigation" aria-label="sub menu" data-qa="sub-navigation">
        <ul class="app-tab-navigation__list govuk-!-display-none-print">
          <li class="app-tab-navigation__item">
            <%= govuk_link_to(
              t('.active_tokens'),
              provider_interface_organisation_settings_organisation_api_tokens_path(@provider),
              class: 'app-tab-navigation__link',
              aria: { current: params[:filter_tab].blank? ? 'page' : '' },
            ) %>
          </li>

          <li class="app-tab-navigation__item">
            <%= govuk_link_to(
              t('.revoked_tokens'),
              provider_interface_organisation_settings_organisation_api_tokens_path(
                @provider,
                filter_tab: 'revoked',
              ),
              class: 'app-tab-navigation__link',
              aria: { current: params[:filter_tab] == 'revoked' ? 'page' : '' },
            ) %>
          </li>
        </ul>
      </nav>

      <%= render ProviderInterface::APITokensTableComponent.new(api_tokens: @api_tokens) %>
    <% end %>
  </div>
</div>
