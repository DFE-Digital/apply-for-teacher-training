<%= form_with model: @pool_invite, url: do |f| %>
  <%= f.govuk_error_summary %>

  <%= f.hidden_field :return_to, value: params[:return_to] || @pool_invite.return_to %>
  <%= f.govuk_radio_buttons_fieldset :provider_message,
                                     legend: { text: t('.title'), size: 'l', class: 'govuk-!-margin-bottom-6' } do %>
    <p class="govuk-hint">
      <% component = ProviderInterface::FindCandidates::InviteLocationPreferencesComponent.new(application_form: @candidate.current_application) %>
      <% if component.specific_locations? %>
        <%= t('.preferred_location_hint') %>
        <%= render component %>
      <% else %>
        <%= t('.no_preferred_location_hint') %>
      <% end %>
    </p>
    <%= render 'invitation_email' %>

    <%= f.govuk_radio_button :provider_message, true, label: { text: 'Yes' }, link_errors: true do %>
      <div class="govuk-!-margin-bottom-2">
        <%= f.govuk_text_area(
          :message_content,
          label: { text: t('.enter_message'), class: 'govuk-!-margin-bottom-3' },
          hint: -> { render 'formatting_information' },
          value: current_provider_user.in_use_provider_user_content_template&.body,
          max_words: 200,
        ) %>
      </div>

      <div class="govuk-checkboxes--small">
        <%= f.govuk_check_box(
          :remember,
          true,
          multiple: false,
          label: { text: t('.remember') },
          small: true,
        ) %>
      </div>
    <% end %>

    <%= f.govuk_radio_button :provider_message, false, label: { text: 'No' } %>
  <% end %>

  <%= f.govuk_submit %>
<% end %>
